DB=/opt/resale-watch/searches.db
# OAuth client-credentials token, scope https://api.ebay.com/oauth/api_scope; expires 2h
EBAY_TOKEN=
APIFY_TOKEN=
# Optional: _vinted_fr_session=... from browser, avoids 403
VINTED_COOKIE=
# User-Agent of the browser the cookie came from
VINTED_UA=
# Full URL e.g. https://ntfy.sh/your-secret-topic; empty disables push
NTFY_TOPIC=
# stdio | streamable-http
MCP_TRANSPORT=stdio
